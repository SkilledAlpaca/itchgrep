# Copy to `.env` (same directory as docker-compose.yml) and edit.
# Docker Compose reads `.env` automatically, so this works identically in
# bash, PowerShell and cmd - no shell-specific env var syntax needed.
#
#   cp .env.example .env        # bash
#   copy .env.example .env      # cmd / PowerShell
#
# `.env` is gitignored. Full reference for every variable, including format,
# failure behavior and change safety: docs/configuration.md.
#
# NOTE: these are read when the dataservice container STARTS. Editing this
# file mid-crawl has no effect; `docker compose up -d --no-deps dataservice`
# recreates the container, which also discards the crawl in progress.

# ---------------------------------------------------------------------------
# Crawl tuning (dataservice)
# ---------------------------------------------------------------------------

# Outbound requests/second to itch.io, retries included. The rate is fixed:
# the fetcher does not speed up or slow down on its own. A 429 pauses every
# worker for any Retry-After the server sent, then the crawl resumes here.
#
# If you see a flood of 429s, do NOT reach for this first. itch.io sets an
# `itchio_token` cookie and refuses cookieless clients about half the time no
# matter how slowly they ask - measured at 8/16 requests refused without a
# cookie jar versus 0/16 with one, at one request per second. That failure
# looks exactly like rate limiting and cannot be fixed by slowing down. Watch
# the `429s:` counter in the scrape progress log instead.
SCRAPE_RPS=2

# Cap on total pages fetched across every view. Leave commented out for a full
# crawl. Uncomment with a small value to smoke-test the entire pipeline -
# tag discovery, crawling, indexing, archiving, upload, webserver startup - in
# a couple of minutes instead of the roughly six hours a full crawl takes.
#
# Produces a deliberately PARTIAL index, so it also disarms COVERAGE_FLOOR and
# shrinks tag discovery. Not for real browsing.
#SCRAPE_MAX_PAGES=20

# How often the dataservice starts a fresh crawl, measured from the last
# successful publish. Go duration syntax ("168h" is weekly).
#CRAWL_INTERVAL=168h

# Stop crawling once this fraction of the catalogue (~108,578 assets) has been
# collected. The last few percent costs disproportionately many requests.
COVERAGE_TARGET=0.95

# Refuse to publish below this fraction, leaving the previous index in place,
# so a stalled run cannot replace a good index with a worse one.
#
# Coverage is the UNION of tag-filtered views deduplicated by GameId, and
# itch.io offers no "NOT tag-X" facet to partition with, so what a full crawl
# actually reaches is measured, not guaranteed. Set this to 0 to publish
# whatever the crawl reaches.
COVERAGE_FLOOR=0.75

# Abandon a view once new (unseen) assets fall below this fraction of a page,
# measured over a trailing 16-page window. At 36 items/page, 0.05 is under ~2
# new assets per page. Assets appear in several views each, so without this
# the overlap dominates the crawl.
SLICE_MIN_YIELD=0.05

# Rediscover the tag universe when the cached tags.json is older than this.
TAG_CACHE_MAX_AGE=168h

# Ignore a crawl checkpoint older than this when resuming.
#CHECKPOINT_MAX_AGE=24h

# ---------------------------------------------------------------------------
# Production deploy (all REQUIRED on the production host; see
# docs/deployment.md for the full first-deploy walkthrough)
# ---------------------------------------------------------------------------

# Pins the compose project name so containers are itchgrep-*. Without it,
# compose derives the project from the checkout directory name ("src" on the
# production host), creating a duplicate project that fails on port binds.
#COMPOSE_PROJECT_NAME=itchgrep

# Host path for the shared data directory (crawl output + search index).
# Unset, compose uses a named Docker volume instead, which works out of the
# box. A bind-mounted path must be writable by uid 65532 - one-time
# `chown -R 65532:65532 <path>` on the host; see docs/deployment.md.
#DATA_PATH=/mnt/user/appdata/itchgrep/data

# The Cloudflare Tunnel credential for the `--profile public` cloudflared
# container. SECRET - never commit it; rotation: docs/disaster-recovery.md.
# Obtain from the Cloudflare Zero Trust dashboard (Networks -> Tunnels).
#CLOUDFLARE_TUNNEL_TOKEN=eyJhFAKEEXAMPLEONLYxxxxxxxxxxxxxxxxxxxxxx

# Behind Cloudflare, the visitor's address arrives in the CF-Connecting-IP
# header; set true so rate limiting and logs key on the visitor rather than
# collapsing the whole internet into the tunnel's one address. The header is
# only honored from peers inside TRUSTED_PROXY_CIDRS.
#TRUST_PROXY_HEADERS=true

# Which peer addresses may assert CF-Connecting-IP. Defaults to cloudflared's
# static address on the compose network; only change for a different topology.
#TRUSTED_PROXY_CIDRS=172.30.99.10/32

# ---------------------------------------------------------------------------
# Webserver tuning (optional; defaults documented in docs/configuration.md)
# ---------------------------------------------------------------------------

# Per-visitor rate limit: sustained requests/second and burst allowance.
#RATE_LIMIT_RPS=5
#RATE_LIMIT_BURST=20

# ---------------------------------------------------------------------------
# Read by host scripts or direct runs only - NOT by docker compose
# ---------------------------------------------------------------------------

# Where scripts/export-logs.sh (the host log follower, run outside Compose -
# see docs/observability.md) writes its log files. Read from the shell
# environment of that script, not from this file.
#LOG_EXPORT_DIR=/mnt/user/appdata/itchgrep/logs

# Upper bound on how many tags discovery may visit. It costs one request per
# tag, so this is the main cost of a cold start. In practice discovery
# converges at ~130 asset tags on its own, well under this bound - raising it
# does not find more tags. ONLY read on a direct run (task dataservice /
# go run): docker-compose.yml deliberately has no MAX_TAGS pass-through, so
# setting it here does nothing for a compose run - see the comment in
# docker-compose.yml.
#MAX_TAGS=1000
