# Use the official Golang image to create a build artifact.
# This is based on Debian and sets the GOPATH environment variable at /go.
#
# Pinned by digest, not just tag: golang:1.27 is a moving target that gets
# repushed on every point release and base-image rebuild, so a tag-only FROM
# is not reproducible - the exact same Dockerfile can build a different image
# tomorrow. The tag is kept alongside the digest so a human reading this line
# still sees which Go version it is without resolving the hash. Refresh
# deliberately, never as a drive-by:
#   docker buildx imagetools inspect golang:1.27
FROM golang:1.27@sha256:957861185dbf29d93668ace41e011d091c6e779953d47f0316ef2cc58e28fe2b AS builder

# Create and change to the app directory.
WORKDIR /app

# go.mod/go.sum copied first, before templ is installed, so its version can
# be derived from the same file the build compiles against - the same
# derivation .github/workflows/ci.yml uses, and for the same reason its own
# comment gives: "so it can never drift from the version the repo actually
# builds with." A hand-pinned `@vX.Y.Z` literal here was a second copy of
# that version that had to be bumped by hand in lockstep with go.mod, and
# could (and did) drift from it silently - see docs/dependencies.md.
COPY go.mod go.sum ./

# Install templ pinned to go.mod's version, never to @latest.
RUN templ_version="$(go list -m -f '{{.Version}}' github.com/a-h/templ)" && \
	go install "github.com/a-h/templ/cmd/templ@${templ_version}"

# Copy the rest of the source.
COPY cmd/webserver/ cmd/webserver/
COPY internal/ internal/
COPY pkg/ pkg/

# Fetch dependencies.
RUN go mod download
RUN templ generate

# Build the binary. CGO is disabled so the result is a static binary with no
# glibc dependency on the distroless runtime image; every dependency here is
# pure Go. -s -w strips the symbol table and DWARF data to shrink the image.
RUN CGO_ENABLED=0 go build -v -ldflags="-s -w" -o server ./cmd/webserver

# A /data seed for the runtime stage: distroless has no shell to
# mkdir/chown with, so the directory is created here and COPY --chown'd
# below. Shipping /data in the image, owned by 65532, is what lets Docker
# seed a fresh *named* volume with the right ownership on first use -
# without it the volume materializes owned by root and every write from
# the nonroot process fails. The placeholder file is load-bearing:
# measured on Docker 27, copy-up applies the image directory's ownership
# to the volume root only when the directory is non-empty.
RUN mkdir /data-seed && touch /data-seed/.docker-volume-seed

# Use a Docker multi-stage build to create a lean production image.
# https://docs.docker.com/develop/develop-images/multistage-build/#use-multi-stage-builds
#
# :nonroot, not the bare tag: the plain base-debian12 image has no USER, so
# the process runs as uid 0 with nothing to stop it. :nonroot bakes in
# `USER nonroot:nonroot` (65532:65532), so no USER line is needed here - the
# base image itself refuses to run the server as root.
#
# CONSEQUENCE FOR THE /data VOLUME: uid 65532 must be able to write /data, or
# this container cannot create/open index.bleve/ and fails outright (the
# webserver takes a bleve lock even for search-only use - see the volumes:
# comment in docker-compose.yml). The image ships an empty /data owned by
# 65532 (the COPY --chown below) so a fresh *named* volume is seeded with
# that ownership on first use; a bind-mounted DATA_PATH is never chown'd
# automatically by Docker. See docker-compose.yml's volumes: comment for the
# required one-time `chown -R 65532:65532` step on bind mounts.
#
# Pinned by digest for the same reproducibility reason as the builder stage
# above - refresh deliberately:
#   docker buildx imagetools inspect gcr.io/distroless/base-debian12:nonroot
FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5

# Copy the compiled application from the builder stage.
COPY --from=builder /app/server /
# The empty, correctly-owned /data mount point - see the builder-stage
# comment at RUN mkdir /data-seed.
COPY --from=builder --chown=65532:65532 /data-seed /data

# Your application listens on port 8080.
EXPOSE 8080

# Set the environment variables
ENV PAGE_SIZE=36

# Run your application.
CMD ["/server"]

