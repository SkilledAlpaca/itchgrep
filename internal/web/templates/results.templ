package templates

import "net/url"
import "strings"
import "itchgrep/pkg/models"
import "itchgrep/pkg/money"

// Results is one page of results plus the context rendered around them. It
// mirrors what the query layer returns, restated here so the templates package
// depends on nothing heavier than the models.
type Results struct {
	Assets  []models.Asset
	Total   int64
	Tags    []models.Tag
	Page    int64
	HasMore bool

	// Rates converts prices for display. Carried on the results rather than
	// looked up by the templates because it has to be the same snapshot the
	// index was built with, and only the handler knows which that is.
	Rates money.Rates

	// HasRecency reports whether the dataset can be ordered by recency at all.
	// When it cannot, the control is not rendered - an ordering offered over
	// data that cannot support it is worse than one that is missing.
	HasRecency bool

	// HasPriceBands reports whether the index carries converted dollar values.
	// When it does not, the two bounded price filters are not rendered, for the
	// same reason: they would match nothing and look like an answer.
	HasPriceBands bool

	// LikeTitle is the title of the ?like= source asset, carried alongside the
	// results rather than looked up again by the template - see
	// cache.Results.LikeTitle. Empty when Like is unset or matched nothing.
	LikeTitle string

	// Generation names the data and the code the page was rendered from: the
	// dataset's publish time in Unix seconds, a dash, and a prefix of app.js's
	// content fingerprint. The sidebar's on-demand list is fetched under it, so a
	// new publish, or a deploy that changes the script (and with it the markup
	// the list is swapped into), gets its own cache key at the edge.
	Generation string

	// AnyWordFallback is set when no asset contains every query word and
	// these are the ones matching any word. See cache.Results.AnyWordFallback.
	AnyWordFallback bool

	// FirstPageURL, when set, is where "back to the first page" goes, for a
	// page whose first page is not at f.PageURL(1) - a /tag/{slug} page.
	FirstPageURL string
}

// priceFilterLabel is the human name of a price filter, for the control and for
// the removable chip that reports it.
func priceFilterLabel(price string) string {
	switch price {
	case models.PricingFree:
		return "Free"
	case models.PricingPaid:
		return "Paid"
	case models.PricingUnder5:
		return "Under $5"
	case models.PricingUnder20:
		return "Under $20"
	default:
		return price
	}
}

// sidebarTags is how many facets the sidebar renders. The vocabulary runs to
// several hundred tags and the long tail is single-digit counts, so showing all
// of them would bury the useful ones under noise, and sending all of them to
// every visitor, on every filter tap, was most of the markup of a results page.
// The rest is fetched on demand (see TagList) or, with scripting off, by
// following the "More tags" link to a page that lists them all.
const sidebarTags = 40

// MoreTagsParam is the query parameter of the no-script "More tags" link. It
// asks the full page to list every tag in the sidebar and changes nothing
// about which assets match.
const MoreTagsParam = "alltags"

// tagTailURL is the endpoint that renders the whole ranked sidebar list for
// these filters, the same query string the results fragment takes (so it is as
// cacheable as the results it belongs to) plus v, the generation the page was rendered
// from: the data time and a prefix of app.js's fingerprint (see Generation). Each generation is its own cache key, so a copy of the
// fragment from before a publish is never handed to a page from after it.
//
// Sort and currency are carried only when set: they change nothing about the
// tags, but the rows' links lead to a results page and have to keep them. The
// common case has neither, and shares one key.
func tagTailURL(f Filters, generation string) string {
	v := f.Values()
	if generation != "" {
		v.Set("v", generation)
	}
	if len(v) == 0 {
		return "/results/tags"
	}
	return "/results/tags?" + v.Encode()
}

// moreTagsHref is the no-script "More tags" destination: this page again with
// the whole list.
func moreTagsHref(f Filters, r Results) string {
	if r.FirstPageURL != "" {
		return r.FirstPageURL + "?" + MoreTagsParam + "=1"
	}
	f.AllTags = true
	return f.PageURL(1)
}

// sidebarHead is the tags the sidebar renders in the page itself.
func sidebarHead(f Filters, tags []models.Tag) []models.Tag {
	if f.AllTags || len(tags) <= sidebarTags {
		return tags
	}
	return tags[:sidebarTags]
}

// sidebarRest is how many tags the page leaves for TagList.
func sidebarRest(f Filters, tags []models.Tag) int {
	if f.AllTags || len(tags) <= sidebarTags {
		return 0
	}
	return len(tags) - sidebarTags
}

// facetHref is where a sidebar tag link goes. On the bare front page that is
// the tag's own page, /tag/{slug}: crawlers get one clean, canonical, followable
// path per tag, and everything else stays a nofollow query string. The htmx
// attributes are unchanged either way, so with scripting on the click still
// swaps results in place and pushes the /?tags= address.
func facetHref(f Filters, slug string) string {
	if f.Bare() {
		return "/tag/" + url.PathEscape(slug)
	}
	return f.WithTag(slug).ShareURL()
}

// activeAttrs marks the control for the filter that is currently applied.
var activeAttrs = templ.Attributes{"aria-current": "true"}

func excludeAttrs(slug string) templ.Attributes {
	return templ.Attributes{
		"title":      "Hide assets tagged " + slug,
		"aria-label": "Hide assets tagged " + slug,
	}
}

// anyWordNote is shown beside the count when no asset has every query word.
const anyWordNote = "No results contain every word; showing results that match any word."

func resultSummary(r Results) string {
	if r.Total == 1 {
		return "1 asset"
	}
	return humanizeCount(r.Total) + " assets"
}

// resultStatus is what the live region says after a swap: the count, and what
// it is a count of. The filters are named because the count alone can repeat
// ("17 assets" after adding a tag that excluded nothing), and a live region
// whose text did not change may not be announced at all.
//
// A reached cap is appended because the sidebar says so only in the swapped
// region, which is not live: the visitor is otherwise never told why the tag
// links went dead.
func resultStatus(f Filters, r Results) string {
	status := resultSummary(r)
	if summary := filterSummary(f, r.LikeTitle); summary != "" {
		status += " for " + summary
	}
	if r.AnyWordFallback {
		status += ". " + anyWordNote
	}
	if f.AtTagLimit() {
		status += ". Tag limit reached."
	}
	if f.AtNotTagLimit() {
		status += ". Exclusion limit reached."
	}
	return status
}

// filterLink is the one shape every filter link on the site takes: an anchor
// whose href is the state it leads to, so the page works with JavaScript
// disabled, plus the htmx attributes that swap the results in place when it is
// not. Everything that changes what the results show goes through here, so a
// rule about filter links (rel, aria state) is made once.
//
// href is a parameter, not derived from next, because the one link that should
// differ is the unfiltered sidebar's, which points at /tag/{slug} - see
// facetHref. attrs carries per-link extras such as aria-current.
//
// hx-target and hx-swap are not repeated on every link: htmx inherits them, and
// the .search-page container carries them (see Index). A page has hundreds of
// these links, and the sidebar alone has eighty.
templ filterLink(class string, href string, next Filters, attrs templ.Attributes) {
	<a
		class={ class }
		href={ templ.SafeURL(href) }
		{ filterRel(href)... }
		hx-get={ next.FragmentURL(1) }
		{ attrs... }
	>
		{ children... }
	</a>
}

// filterRel marks a filter link rel="nofollow": the destinations differ only
// by query string, and a crawler walking them multiplies every tag by every
// other. The exception is a /tag/ path, which is the clean, sitemap-listed page
// crawlers are meant to follow.
func filterRel(href string) templ.Attributes {
	if strings.HasPrefix(href, "/tag/") {
		return nil
	}
	return templ.Attributes{"rel": "nofollow"}
}

// control is filterLink for the common case of a plain text label whose
// destination is next's own address.
templ control(class string, next Filters, label string) {
	@filterLink(class, next.ShareURL(), next, nil) {
		{ label }
	}
}

// removable renders a control that removes a filter. The ✕ is decoration, so it
// is hidden from assistive technology and the action is spelled out instead:
// screen readers announce the glyph as "multiplication x". The leading spaces
// are string expressions because templ trims literal whitespace at the edge of
// an element, which would glue the hidden text onto the label.
templ removable(class string, next Filters, label string) {
	@filterLink(class, next.ShareURL(), next, nil) {
		{ label }<span class="visually-hidden">{ " (remove filter)" }</span><span aria-hidden="true">{ " ✕" }</span>
	}
}

// sortOption renders one segment of the sort control, active or not.
templ sortOption(f Filters, sort string, label string) {
	if f.ResolvedSort() == sort {
		<span class="segment is-active" aria-current="true">{ label }</span>
	} else {
		@control("segment", f.WithSort(sort), label)
	}
}

templ SortControl(f Filters, hasRecency bool) {
	<div class="segmented" role="group" aria-label="Sort order">
		if f.Query != "" {
			@sortOption(f, models.SortRelevance, "Best match")
		}
		@sortOption(f, models.SortPopular, "Popular")
		if hasRecency {
			// Only when the dataset carries newest-view ranks. This is not a
			// sort by date - itch.io's listings have none - but by position in
			// itch.io's own newest view, and over an index with no such
			// positions it would order by nothing while claiming otherwise.
			@sortOption(f, models.SortRecent, "Recently added")
		}
		@sortOption(f, models.SortPrice, "Cheapest")
		@sortOption(f, models.SortTitle, "A–Z")
	</div>
}

// priceOption renders one price filter. Selecting the active one again clears
// it, so the control is a toggle rather than a radio group with no way back.
templ priceOption(f Filters, price string) {
	if f.Price == price {
		@filterLink("segment is-active", f.WithPrice(price).ShareURL(), f.WithPrice(price), activeAttrs) {
			{ priceFilterLabel(price) }<span class="visually-hidden">{ " (remove filter)" }</span><span aria-hidden="true">{ " ✕" }</span>
		}
	} else {
		@control("segment", f.WithPrice(price), priceFilterLabel(price))
	}
}

templ PriceControl(f Filters, hasPriceBands bool) {
	<div class="segmented" role="group" aria-label="Price">
		@priceOption(f, models.PricingFree)
		if hasPriceBands {
			// Free and paid are read straight off the listing, so they work on
			// any index. The bounded bands need a converted dollar value, which
			// only an index built by a dataservice that collects one carries.
			@priceOption(f, models.PricingUnder5)
			@priceOption(f, models.PricingUnder20)
		}
		@priceOption(f, models.PricingPaid)
	</div>
}

// CurrencyControl converts displayed prices into one currency.
//
// A plain GET form rather than links, because the options are a list of thirty
// rather than a handful, and because it must work with scripting off - so the
// rest of the filter state travels as hidden fields, exactly as the search box
// does. It changes nothing about which assets match: this is a reading aid, and
// the conversions are approximate by construction.
templ CurrencyControl(f Filters, rates money.Rates) {
	<form class="currency" method="get" action="/" hx-get="/results" hx-target="#results-region" hx-swap="innerHTML">
		@hiddenFilters(f, false)
		<label class="currency-label" for="currency-select">Show prices in</label>
		<select id="currency-select" name="cur" class="currency-select">
			<option value="" selected?={ f.Currency == "" }>as listed</option>
			for _, code := range rates.Currencies() {
				<option value={ code } selected?={ f.Currency == code }>{ code }</option>
			}
		</select>
		<button type="submit" class="currency-go">Set</button>
		if f.Currency != "" {
			<span class="currency-note">
				≈ converted at
				<a href={ templ.SafeURL(rates.Source) } target="_blank" rel="noopener">ECB rates
					@NewTabHint()
				</a>
				of { rates.Date }
			</span>
		}
	</form>
}

func oobAttrs(oob bool) templ.Attributes {
	if !oob {
		return nil
	}
	return templ.Attributes{"hx-swap-oob": "true"}
}

// SearchFilters is the search box's hidden fields in their wrapper. oob adds
// the attribute that makes htmx swap it in from a fragment.
templ SearchFilters(f Filters, oob bool) {
	<div id="search-filters" class="search-filters" data-query={ f.Query } { oobAttrs(oob)... }>
		@hiddenFilters(f, true)
	</div>
}

// hiddenFilters carries the current filter state through a form submission, so
// that changing the currency or running a new search does not silently discard
// the tags and the query the visitor already chose.
//
// The two forms own different fields. The search box supplies q itself and
// deliberately drops like, since a typed search is a new intent rather than a
// refinement of "similar to X". It keeps sort: a visitor who chose an ordering
// still wants it for the next search. The currency form supplies cur itself and
// keeps everything else.
templ hiddenFilters(f Filters, forSearchBox bool) {
	if !forSearchBox && f.Query != "" {
		<input type="hidden" name="q" value={ f.Query }/>
	}
	for _, tag := range f.Tags {
		<input type="hidden" name="tags" value={ tag }/>
	}
	for _, tag := range f.NotTags {
		<input type="hidden" name="not" value={ tag }/>
	}
	if !forSearchBox && f.Like != "" {
		<input type="hidden" name="like" value={ f.Like }/>
	}
	if f.Author != "" {
		<input type="hidden" name="author" value={ f.Author }/>
	}
	if f.Price != "" {
		<input type="hidden" name="price" value={ f.Price }/>
	}
	if f.Sort != "" {
		<input type="hidden" name="sort" value={ f.Sort }/>
	}
	if forSearchBox && f.Currency != "" {
		<input type="hidden" name="cur" value={ f.Currency }/>
	}
}

// ActiveFilters shows what is currently narrowing the results, each removable.
// Without it a tag applied from the sidebar, then scrolled past, is invisible -
// and an empty result set looks like a broken search rather than an
// over-constrained one.
templ ActiveFilters(f Filters, likeTitle string) {
	if f.Any() {
		<div class="active-filters">
			<span class="active-label">Filtering by</span>
			if f.Query != "" {
				<span class="chip is-query">“{ f.Query }”</span>
			}
			for _, tag := range f.Tags {
				@removable("chip is-removable", f.WithoutTag(tag), tag)
			}
			for _, tag := range f.NotTags {
				@removable("chip is-removable is-excluded", f.WithoutNotTag(tag), "not "+tag)
			}
			if f.Like != "" && likeTitle != "" {
				// Guarded on likeTitle rather than just f.Like: an id that
				// matched nothing has no title to name, and a chip reading
				// "similar to  ✕" would be worse than no chip at all - the
				// empty-result page below already explains the miss.
				@removable("chip is-removable", f.WithoutLike(), "similar to "+likeTitle)
			}
			if f.Author != "" {
				@removable("chip is-removable is-author", f.WithAuthor(f.Author), "by "+f.Author)
			}
			if f.Price != "" {
				@removable("chip is-removable", f.WithPrice(f.Price), priceFilterLabel(f.Price))
			}
			if f.Narrowed() {
				@control("clear-filters", f.Cleared(), "Clear filters")
			}
		</div>
	}
}

// TagSidebar lists the tags carried by the current results, with counts. The
// counts are over the whole match set rather than the visible page, which is
// what makes it a map of the results rather than a description of them: at a
// glance it says how much of a search is pixel art and how much is 3D.
//
// Only the head is rendered here. The rest is one request away: app.js fetches
// it from data-tail-url when the visitor focuses "Find a tag" or follows "More
// tags". Without scripting "More tags" is an ordinary link to this page with
// every tag listed.
templ TagSidebar(f Filters, r Results) {
	<aside class="facets" aria-label="Filter by tag">
		<h2 class="facets-heading">Tags</h2>
		if len(r.Tags) == 0 {
			<p class="facets-empty">No tags to narrow by.</p>
		} else {
			// A disclosure so a phone does not open on a screenful of tags with
			// the first result below the fold. Rendered open: with scripting off
			// the list is simply there, as it always was, and the summary can
			// still fold it. app.js folds it on a narrow viewport and keeps it
			// open on a wide one, where CSS hides the summary.
			<details class="facets-details" open>
				<summary class="facets-toggle">Filter by tag</summary>
				<label class="facet-search-label" for="facet-search">Find a tag</label>
				<input
					type="text"
					id="facet-search"
					class="facet-search"
					placeholder="find a tag..."
					autocomplete="off"
					data-facet-search
				/>
				<ul
					class="facet-list"
					id="facet-list"
					if sidebarRest(f, r.Tags) > 0 {
						data-tail-url={ tagTailURL(f, r.Generation) }
						hx-sync="this:replace"
					}
				>
					for _, tag := range sidebarHead(f, r.Tags) {
						@facetItem(f, tag, false)
					}
				</ul>
				if n := sidebarRest(f, r.Tags); n > 0 {
					<p class="facets-more-wrap">
						<a class="facets-more" href={ templ.SafeURL(moreTagsHref(f, r)) } rel="nofollow" data-facets-more>
							More tags<span class="visually-hidden">{ " (" + humanizeCount(int64(n)) + " more)" }</span>
						</a>
					</p>
				}
				if f.AtTagLimit() {
					<p class="facets-empty">Tag limit reached.</p>
				}
				if f.AtNotTagLimit() {
					<p class="facets-empty">Exclusion limit reached.</p>
				}
			</details>
		}
	</aside>
}

// facetItem is one row of the sidebar: the tag link and its exclude control.
// tail marks a row that belongs to the on-demand part of the list; those start
// hidden and app.js reveals them when the visitor searches or asks for more.
templ facetItem(f Filters, tag models.Tag, tail bool) {
	<li data-facet={ tag.Slug } data-facet-tail?={ tail } hidden?={ tail }>
		if f.AtTagLimit() {
			// Plain text, not a link: WithTag refuses at the
			// cap, so the link would lead to the page it is on.
			<span class="facet is-capped">
				<span class="facet-name">{ tag.Slug }</span>
				<span class="facet-count">{ humanizeCount(tag.Count) }</span>
			</span>
		} else {
			@filterLink("facet", facetHref(f, tag.Slug), f.WithTag(tag.Slug), nil) {
				<span class="facet-name">{ tag.Slug }</span>
				<span class="facet-count">{ humanizeCount(tag.Count) }</span>
			}
		}
		// A sibling of the facet link rather than a child of it:
		// nesting one anchor inside another is invalid, and
		// browsers resolve it by silently dropping the inner one.
		// Omitted at the exclusion cap for the reason above.
		if !f.AtNotTagLimit() {
			@filterLink("facet-exclude", f.WithNotTag(tag.Slug).ShareURL(), f.WithNotTag(tag.Slug), excludeAttrs(tag.Slug)) {
				−
			}
		}
	</li>
}

// TagList is the whole ranked sidebar list as rows: the fragment app.js swaps
// into the list. The head rows are shown, the rest start hidden for the same
// reason the page's tail does: the visitor chooses when they appear. Sending the
// head again, not just the tail, is what lets the swap replace the list instead
// of appending to a head that may come from another data generation.
templ TagList(f Filters, tags []models.Tag) {
	for i, tag := range tags {
		@facetItem(f, tag, i >= sidebarTags)
	}
}

// ResultsFragment is the response to a first-page /results request: the region
// itself plus the two things that have to travel with it but live elsewhere in
// the document.
//
// The <title> is how the tab's title follows the filters (WCAG 2.4.2): htmx
// applies a <title> found in a swapped response to the document. It is not part
// of ResultsRegion because that component is also rendered inside the full
// page, where a second <title> in the body would be invalid.
//
// The #result-status element is an out-of-band swap, "innerHTML" so the live
// region node itself is kept and only its text changes. Replacing the node
// would defeat the point - see Index.
//
// #search-filters is out of band too, and for the same reason it cannot live
// inside the region: the search box sits outside it so that typing and focus
// survive every swap, but its hidden fields must follow the filters or the
// next submitted search would send the ones the page was first rendered with.
// It is swapped as a whole (outerHTML) because it carries data-query, which
// app.js reads to bring the visible box in line with the pushed address; the
// element holds nothing that can have focus. Only here, in the first-page
// fragment: a load-more page does not change any filter.
templ ResultsFragment(f Filters, r Results) {
	<title>{ PageTitle(f, r.LikeTitle) }</title>
	<p id="result-status" hx-swap-oob="innerHTML">{ resultStatus(f, r) }</p>
	@SearchFilters(f, true)
	@ResultsRegion(f, r)
}

// ResultsRegion is everything below the search box: the sidebar, the controls
// and the first page of results. It is what every filter link swaps, because
// changing a filter changes all three - the tag counts in the sidebar are
// counts within the new result set, not the old one.
templ ResultsRegion(f Filters, r Results) {
	@TagSidebar(f, r)
	<div class="results-main">
		<div class="toolbar">
			<div class="toolbar-lead">
				// The skip link's target and, after a filter swap, where focus
				// lands (see app.js). Visible rather than visually hidden: a
				// focus ring on an element nobody can see tells a sighted
				// keyboard user nothing. tabindex -1 so it is a script and
				// fragment target without becoming a tab stop.
				<h2 id="results" class="results-heading" tabindex="-1">Results</h2>
				// The count is the visible half. Announcing it is the job of
				// #result-status, which lives outside this region.
				<span class="result-count">{ resultSummary(r) }</span>
				if r.AnyWordFallback {
					// Visible, unlike the sentence in #result-status, so sighted
					// visitors and full page loads see it too. Not a live region:
					// the status line already announces it.
					<span class="result-note">{ anyWordNote }</span>
				}
			</div>
			<div class="toolbar-controls">
				@PriceControl(f, r.HasPriceBands)
				@SortControl(f, r.HasRecency)
			</div>
		</div>
		@CurrencyControl(f, r.Rates)
		@ActiveFilters(f, r.LikeTitle)
		<div id="asset-list" class="asset-grid">
			@AssetPage(f, r)
		</div>
	</div>
}
