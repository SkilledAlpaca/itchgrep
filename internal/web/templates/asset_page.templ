package templates

import "fmt"
import "itchgrep/pkg/models"

// maxTagsShown caps the chips rendered per card. Assets carry ~5 tags on
// average but some carry dozens, and letting those grow unbounded makes the
// grid rows ragged for no gain.
const maxTagsShown = 5

func shownTags(tags []string) []string {
	if len(tags) > maxTagsShown {
		return tags[:maxTagsShown]
	}
	return tags
}

templ AssetCard(asset models.Asset) {
	<article class="asset">
		<a class="asset-link" href={ templ.SafeURL(asset.Link) } target="_blank" rel="noopener">
			if asset.ThumbUrl != "" {
				<img
					src={ asset.ThumbUrl }
					alt={ fmt.Sprintf("Thumbnail for %s", asset.Title) }
					loading="lazy"
					decoding="async"
				/>
			}
			<div class="asset-body">
				<div class="asset-title">{ asset.Title }</div>
				<div class="asset-author">{ asset.Author }</div>
				if asset.Description != "" {
					<p class="asset-description">{ asset.Description }</p>
				}
			</div>
		</a>
		if len(asset.Tags) > 0 {
			<div class="asset-tags">
				for _, tag := range shownTags(asset.Tags) {
					<button type="button" class="tag" data-tag={ tag }>{ tag }</button>
				}
			</div>
		}
	</article>
}

// NoResults is what an exhausted or empty search renders. Without it a query
// matching nothing produced a silently blank page.
templ NoResults(query string) {
	<div class="notice">
		<h2>No assets match “{ query }”</h2>
		<p>Try a broader term, or click a tag on any asset to search by it.</p>
	</div>
}

templ AssetPage(pageNum int64, assets []models.Asset, isQuery bool, query string) {
	if len(assets) == 0 && isQuery && pageNum == 1 {
		@NoResults(query)
	}
	for _, asset := range assets {
		@AssetCard(asset)
	}
	if len(assets) > 0 {
		if !isQuery {
			<div
				id="asset-load-trigger"
				hx-get={ fmt.Sprintf("/assets/%d", pageNum+1) }
				hx-trigger="revealed"
				hx-swap="outerHTML"
			></div>
		} else {
			<div
				id="asset-load-trigger"
				hx-get={ searchURL(query, pageNum+1) }
				hx-trigger="revealed"
				hx-swap="outerHTML"
			></div>
		}
	}
}
