package templates

import "encoding/json"
import "fmt"
import "itchgrep/pkg/models"

// hxValsQuery builds the JSON object used for the htmx hx-vals attribute,
// safely escaping the query string via encoding/json instead of naive
// string interpolation (which breaks on queries containing a double quote).
func hxValsQuery(query string) string {
	b, err := json.Marshal(map[string]string{"query": query})
	if err != nil {
		// json.Marshal on a map[string]string cannot fail; fall back to an
		// empty query object just in case.
		return `{"query":""}`
	}
	return string(b)
}

templ AssetPage(pageNum int64, assets []models.Asset, isQuery bool, query string) {
	for _, asset := range assets {
		<div class="asset">
			<a href={ templ.SafeURL(asset.Link) }>
				<img src={ asset.ThumbUrl }/>
				<div class="asset-details">
					<div class="asset-head">
						<div class="asset-title">{ asset.Title }</div>
						<div class="asset-author">{ asset.Author }</div>
					</div>
					if asset.Description != "" {
						<blockquote class="asset-description">{ asset.Description }</blockquote>
					}
				</div>
			</a>
		</div>
	}
	if len(assets) > 0 {
		if !isQuery {
			<div
				id="asset-load-trigger"
				hx-get={ fmt.Sprintf("/assets/%d", pageNum+1) }
				hx-trigger="revealed"
				hx-swap="outerHTML"
				style="height: 10rem; width: 1rem;"
			></div>
		} else {
			<div
				id="asset-load-trigger"
				hx-vals={ hxValsQuery(query) }
				hx-post={ fmt.Sprintf("/query/%d", pageNum+1) }
				hx-trigger="revealed"
				hx-swap="outerHTML"
				style="height: 10rem; width: 1rem;"
			></div>
		}
	}
}
