package templates

import "fmt"
import "strconv"
import "itchgrep/pkg/models"
import "itchgrep/pkg/money"

// maxTagsShown caps the chips rendered per card. Assets carry ~5 tags on
// average but some carry dozens, and letting those grow unbounded makes the
// grid rows ragged for no gain.
const maxTagsShown = 5

// shownTags picks the chips a card renders. Applied tags come first, so that a
// card never hides the very tag the visitor filtered on behind the cap; the
// rest keep their order.
func shownTags(f Filters, tags []string) []string {
	if len(tags) <= maxTagsShown {
		return tags
	}
	ordered := make([]string, 0, len(tags))
	for _, tag := range tags {
		if f.HasTag(tag) {
			ordered = append(ordered, tag)
		}
	}
	for _, tag := range tags {
		if !f.HasTag(tag) {
			ordered = append(ordered, tag)
		}
	}
	return ordered[:maxTagsShown]
}

// hiddenTagCount is how many of a card's tags shownTags left off.
func hiddenTagCount(tags []string) int {
	if len(tags) > maxTagsShown {
		return len(tags) - maxTagsShown
	}
	return 0
}

// NewTabHint tells assistive technology that a target="_blank" link leaves the
// page, which nothing else about the link says. The leading space is a string
// expression because templ would trim a literal one.
templ NewTabHint() {
	<span class="visually-hidden">{ " (opens in new tab)" }</span>
}

// priceLabel is what the badge on a card says.
// Three things are folded in here, in order of how much they change the
// meaning. A pay-what-you-want asset with a zero minimum is free but not merely
// free - "Name your price" is what itch.io calls it, and calling it "Free"
// hides that the author is asking. A paid one with a minimum is "$4.95+",
// because the price shown is a floor. And a converted figure is prefixed with
// "≈", because it was computed from a snapshot rather than quoted by itch.io.
func priceLabel(f Filters, asset models.Asset, rates money.Rates) string {
	if asset.Free() {
		if asset.PayWhatYouWant {
			return "Name your price"
		}
		return "Free"
	}

	shown := asset.Price
	if f.Currency != "" {
		if parsed, ok := money.Parse(asset.Price); ok {
			if converted, ok := rates.Convert(parsed, f.Currency); ok {
				shown = "≈ " + converted.Display
			}
		}
	}
	if asset.PayWhatYouWant {
		return shown + "+"
	}
	return shown
}

// priceTitle keeps the figure itch.io actually quoted within reach whenever the
// badge is showing something derived from it. A converted price is this site's
// arithmetic, not the seller's offer, and the hover has to be able to say so.
func priceTitle(f Filters, asset models.Asset, rates money.Rates) string {
	if asset.Free() {
		if asset.PayWhatYouWant {
			return "Pay what you want, including nothing"
		}
		return ""
	}
	if f.Currency == "" {
		return ""
	}
	if _, ok := money.Parse(asset.Price); !ok {
		return ""
	}
	return fmt.Sprintf("Listed at %s; converted at ECB rates of %s", asset.Price, rates.Date)
}

func priceClass(asset models.Asset) string {
	if asset.Free() {
		return "asset-price is-free"
	}
	return "asset-price"
}

// priceAttrs assembles the badge's attributes so that the title is present only
// when there is something to say. Rendering title="" on every card would be
// markup that means nothing and a tooltip that flashes empty on hover.
func priceAttrs(f Filters, asset models.Asset, rates money.Rates) templ.Attributes {
	attrs := templ.Attributes{"class": priceClass(asset)}
	if title := priceTitle(f, asset, rates); title != "" {
		attrs["title"] = title
	}
	return attrs
}

// currentIf is the aria-current attribute for a control that reflects state
// already in force, or nothing.
func currentIf(active bool) templ.Attributes {
	if active {
		return activeAttrs
	}
	return nil
}

// tagClass marks a card's tag chip as already applied, so a card does not
// silently offer a filter that would do nothing.
func tagClass(f Filters, tag string) string {
	if f.HasTag(tag) {
		return "tag is-active"
	}
	return "tag"
}

// authorClass marks the author link on a card as the one currently filtered to,
// for the same reason tagClass does: a control that would change nothing should
// not look like it leads somewhere.
func authorClass(f Filters, author string) string {
	if f.Author == author {
		return "asset-author is-active"
	}
	return "asset-author"
}

templ AssetCard(f Filters, asset models.Asset, rates money.Rates) {
	<article class="asset">
		// A save toggle rather than a link, and a sibling of asset-link
		// rather than nested in it, for the same reason the tag-exclude
		// control sits beside the facet link below: an interactive element
		// cannot nest inside another one. The data-* attributes are the
		// minimal fields app.js needs to re-render this card on /saved
		// without ever asking the server for it again.
		<button
			type="button"
			class="asset-save"
			data-save-toggle
			data-game-id={ asset.GameId }
			data-title={ asset.Title }
			data-author={ asset.Author }
			data-link={ asset.Link }
			data-thumb={ asset.ThumbUrl }
			data-price={ priceLabel(f, asset, rates) }
			aria-pressed="false"
			aria-label={ "Save " + asset.Title }
		>☆</button>
		// templ.URL, not templ.SafeURL: asset.Link and asset.ThumbUrl are
		// scraped verbatim from itch.io's own markup, not constructed by this
		// site, so they are exactly the untrusted input templ.SafeURL's type
		// assertion is meant to gate - a javascript: href in either would
		// otherwise survive unchanged. templ.URL sanitizes instead, rendering
		// anything outside http(s)/mailto as templ's about:invalid sentinel.
		<a class="asset-link" href={ templ.URL(asset.Link) } target="_blank" rel="noopener">
			// alt is empty because the title in the same link already names
			// the asset; "Thumbnail for X" read out ahead of "X" doubled it.
			//
			// src is rendered as a plain string attribute by templ, not one of
			// its recognized URL attributes, so the sanitized value is
			// converted back to string explicitly rather than left as the
			// templ.SafeURL the generated code for src cannot accept.
			if asset.ThumbUrl != "" {
				<img
					src={ string(templ.URL(asset.ThumbUrl)) }
					alt=""
					loading="lazy"
					decoding="async"
				/>
			}
			<div class="asset-body">
				// A heading so a screen reader user can move from result to
				// result; the card link wraps it, which HTML allows. The link
				// keeps its name from content (title, hint, description): naming
				// it with aria-labelledby drops the visible description from the
				// name and fails WCAG 2.5.3 Label in Name.
				<h3 class="asset-title">{ asset.Title }</h3>
				@NewTabHint()
				if asset.Description != "" {
					<p class="asset-description">{ asset.Description }</p>
				}
			</div>
		</a>
		if asset.Author != "" {
			// Outside the card's main link, because it goes somewhere else:
			// "everything else by this person" is the obvious next move after
			// finding one good pack, and nesting it inside the anchor to
			// itch.io would make it unclickable.
			@filterLink(authorClass(f, asset.Author), f.WithAuthor(asset.Author).ShareURL(), f.WithAuthor(asset.Author), currentIf(f.Author == asset.Author)) {
				{ asset.Author }
			}
		}
		<div class="asset-meta">
			<span { priceAttrs(f, asset, rates)... }>{ priceLabel(f, asset, rates) }</span>
			<div class="asset-tags">
				for _, tag := range shownTags(f, asset.Tags) {
					// A link rather than a button: applying a tag is
					// navigation to a filtered view, so it should be
					// shareable, middle-clickable and work without scripts.
					if f.HasTag(tag) {
						@filterLink(tagClass(f, tag), f.ToggleTag(tag).ShareURL(), f.ToggleTag(tag), activeAttrs) {
							<span class="visually-hidden">Remove filter: </span>{ tag }
						}
					} else if f.AtTagLimit() {
						// Not a link: WithTag refuses at the cap, so it would
						// lead to the page it is on.
						<span class="tag is-capped">{ tag }</span>
					} else {
						@filterLink(tagClass(f, tag), f.ToggleTag(tag).ShareURL(), f.ToggleTag(tag), nil) {
							{ tag }
						}
					}
				}
				if n := hiddenTagCount(asset.Tags); n > 0 {
					// Not a link: the cap is about row height, not about
					// hiding tags worth filtering by. The count only says that
					// the list is longer than it looks.
					<span class="tag-more" title={ fmt.Sprintf("%d more tags", n) }>+{ strconv.Itoa(n) }<span class="visually-hidden">{ " more tags" }</span></span>
				}
				// Same visual family as the tag chips above, and present on
				// every card regardless of whether it carries tags: an
				// untagged asset's "similar" link simply lands on a normal
				// empty-result page, the same degradation an unknown ?like=
				// id gets. The title is in the name because 36 links all
				// called "Similar" are indistinguishable out of context.
				@filterLink("tag is-similar", f.WithLike(asset.GameId).ShareURL(), f.WithLike(asset.GameId), nil) {
					Similar<span class="visually-hidden">{ " to " + asset.Title }</span>
				}
			</div>
		</div>
	</article>
}

// NoResults is what an empty result set renders. Without it a query matching
// nothing produced a silently blank page.
//
// It distinguishes the two ways of getting there, because the fix differs: a
// search that found nothing wants a broader term, whereas a search narrowed by
// four tags wants one of them removed.
templ NoResults(f Filters) {
	<div class="notice">
		if f.Query != "" {
			<h2>No assets match “{ f.Query }”</h2>
		} else {
			<h2>No assets match these filters</h2>
		}
		if f.Narrowed() {
			<p>Tags are combined with AND, so every filter narrows the results further. Try removing one.</p>
			@control("clear-filters", f.Cleared(), "Clear filters")
		} else if f.Query != "" {
			// Clear filters would be wrong here - it keeps the query on
			// purpose - and the sidebar has no tags to offer for a search that
			// matched nothing, so the way out is a different term or the front
			// page.
			<p>Check the spelling or try a broader term.</p>
			<p><a href="/">Browse all assets</a></p>
		} else {
			<p>There is nothing to show yet.</p>
		}
	</div>
}

// PastTheEnd is what a page number beyond the last renders: a notice with a
// way back, not an empty grid that reads as a broken page. It stays a 200 with
// the fragment's short cache lifetime rather than redirecting, because a
// redirect would cache poorly and confuse the load-more request that asked.
templ PastTheEnd(f Filters) {
	<div class="notice">
		<h2>No more results</h2>
		<p>That page is past the end of these results.</p>
		<p><a href={ templ.SafeURL(f.PageURL(1)) }>Back to the first page</a></p>
	</div>
}

// AssetPage renders one page of cards, plus the trigger that pulls the next.
//
// The trigger is only emitted when more results actually exist. Letting an
// empty response be the signal to stop, as this used to, costs one wasted
// request at the bottom of every list - and on a filtered search that request
// is a full index pass returning nothing.
templ AssetPage(f Filters, r Results) {
	if len(r.Assets) == 0 && r.Page == 1 {
		@NoResults(f)
	} else if len(r.Assets) == 0 && r.Page > 1 {
		@PastTheEnd(f)
	}
	for _, asset := range r.Assets {
		@AssetCard(f, asset, r.Rates)
	}
	if r.HasMore {
		// A button rather than the bare sentinel div this used to be. A scroll
		// trigger only ever fires for someone scrolling a viewport, so keyboard
		// and screen-reader users reached the bottom of page one and found
		// nothing at all - the remaining results were unreachable rather than
		// merely awkward. It still auto-loads on scroll; the click path is the
		// floor.
		//
		// "intersect once", not "revealed": htmx 1.9 only watches elements
		// whose trigger is exactly "revealed", so "revealed, click" never
		// fired on scroll.
		//
		// hx-sync drops this request when another is in flight on the page,
		// so scroll paging can never cancel a filter request, which replaces
		// whatever it finds (see Index).
		//
		// With scripting off htmx does nothing, so it degrades to a plain link
		// to the next page.
		//
		// No id, deliberately. htmx restores focus after a swap to an element
		// with the same id as the one that had it, which here is the *next*
		// load-more button at the bottom of 36 new cards. Without an id focus
		// is left for app.js, which puts it on the first new card.
		<a
			class="load-more"
			href={ templ.SafeURL(f.PageURL(r.Page + 1)) }
			rel="nofollow"
			hx-get={ f.FragmentURL(r.Page + 1) }
			hx-trigger="intersect once, click"
			hx-sync="closest .search-page:drop"
			hx-target="this"
			hx-swap="outerHTML"
		>Load more results</a>
	}
}
