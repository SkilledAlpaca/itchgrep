package templates

// Layout is the plain page shell: every route that has no per-page head
// content (feed discovery, canonical links, ...) renders through this rather
// than through LayoutHead with an explicit nil, so most handlers do not have
// to know the extension point exists.
templ Layout(title string, shell Shell, content templ.Component) {
	@LayoutHead(title, nil, shell, content)
}

// Shell is what the page frame needs to know that is not page content: the
// masthead's two figures, and which skip link to offer. Every page renders the
// same frame (skip link, masthead, <main>), so it lives here once rather than
// at the top of six page templates.
type Shell struct {
	Age      Freshness
	Coverage Coverage

	// Search marks the pages built around a result list. Their skip link goes
	// straight to it, past the sidebar's forty-odd links, instead of to the top
	// of <main>.
	Search bool
}

// skipHref and skipLabel describe the skip link, the first focusable element
// on every page (WCAG 2.4.1). The masthead and, on search pages, the whole tag
// sidebar are repeated blocks; a keyboard user otherwise tabs through all of
// it to reach the first result.
func (s Shell) skipHref() string {
	if s.Search {
		return "#results"
	}
	return "#main"
}

func (s Shell) skipLabel() string {
	if s.Search {
		return "Skip to results"
	}
	return "Skip to content"
}

// LayoutHead is the page shell with room for extra <head> markup - currently
// just the results page's feed auto-discovery link. A second templ function
// rather than a variadic or options struct: templ components have no
// zero-argument-omission of their own, and head being nil-checked here keeps
// every other caller's Layout call free of it.
templ LayoutHead(title string, head templ.Component, shell Shell, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Full-text search over itch.io game assets, by title, author, description and tag."/>
			<meta name="color-scheme" content="dark light"/>
			<title>
				{ title }
			</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%2314161a'/%3E%3Ctext x='8' y='12' font-family='monospace' font-size='11' font-weight='bold' text-anchor='middle' fill='%237ee787'%3E%3E%3C/text%3E%3C/svg%3E"/>
			<link href="/static/app.css" rel="stylesheet"/>
			// Unlike the feed link (carried through the head param above, only
			// on the results page), every page offers the same one search - so
			// this belongs on the shell itself rather than behind the per-page
			// extension point.
			<link rel="search" type="application/opensearchdescription+xml" title="ITCHGREP" href="/opensearch.xml"/>
			if head != nil {
				@head
			}
			<!-- htmx must run first: app.js's htmx:beforeSwap/htmx:afterSwap
			     listeners are meaningless before htmx registers the events they
			     hook. Both are deferred, and defer preserves document order, so
			     listing htmx first is what guarantees that ordering rather than
			     hoping the browser schedules them right. -->
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href={ templ.SafeURL(shell.skipHref()) }>{ shell.skipLabel() }</a>
			// The masthead is a sibling of <main>, not inside it: a <header>
			// nested in <main> is not a banner landmark, and "skip to main"
			// would land on the repeated masthead it was meant to skip.
			@Masthead(shell.Age, shell.Coverage)
			// tabindex -1 so the "Skip to content" fragment link moves focus
			// here in every browser, not only those that track a sequential
			// focus starting point. It is a script-focus target only.
			<main id="main" tabindex="-1">
				@content
			</main>
		</body>
	</html>
}
