package templates

// IndexAge tells a visitor how old the answers are.
//
// This site is a snapshot of somebody else's catalogue, not a live view of it,
// and nothing else on the page admits that. Without it an empty result for an
// asset published last week reads as "itchgrep is broken" rather than "the
// crawl has not run since".
templ IndexAge(f Freshness, c Coverage) {
	if f.Known() {
		<p class={ "index-age", templ.KV("is-stale", f.Stale()) }>
			index updated
			<time datetime={ f.DateTime() } title={ f.Absolute() }>{ f.Label() }</time>
			if f.Stale() {
				<span class="index-age-warn">— the crawl may have stopped</span>
			}
		</p>
		if c.Known() {
			// Its own line directly under the age, styled identically to it.
			// The two say different kinds of thing - how recent, and how
			// complete - and running them together read as one long sentence
			// about neither, but they are the same class of caveat and should
			// not look like two different kinds of remark.
			//
			// The exact counts stay on hover, marked by the same dotted
			// underline the age uses, so the affordance is learned once.
			<p class="index-age index-coverage">
				<span title={ c.Detail() }>{ c.Label() }</span>
			</p>
		}
		if f.DueKnown() {
			// What the age line leaves open: whether anyone is coming back.
			// "index updated 6 days ago" reads as neglect on its own, and as
			// routine next to the schedule that produced it.
			<p class="index-age index-next">
				next update
				<time datetime={ f.DueDateTime() } title={ f.DueAbsolute() }>{ f.DueLabel() }</time>
			</p>
		}
	}
}

// FeedLink is the results page's feed auto-discovery tag: a reader that
// supports it offers to subscribe without the visitor hunting for a URL.
// Relative like every other internal link the templates package writes - the
// browser resolves it against the page it is embedded in - unlike the feed
// document's own self-referential id and links, which must be absolute.
templ FeedLink(f Filters) {
	<link rel="alternate" type="application/atom+xml" title={ feedTitle(f) } href={ f.FeedURL() }/>
}

templ Masthead(age Freshness, coverage Coverage) {
	<header class="masthead">
		// The age and coverage sit under the wordmark rather than at the foot
		// of the meta column: they describe the index the wordmark stands for,
		// not the links they used to trail.
		<div class="masthead-brand">
			<h1 class="wordmark-heading">
				<a class="wordmark" href="/" aria-label="itchgrep home">
					<span>ITCH</span><span class="mark-grep">GREP</span><span class="caret" aria-hidden="true"></span>
				</a>
			</h1>
			@IndexAge(age, coverage)
		</div>
		<div class="masthead-meta">
			<p>search itch.io/game-assets by text instead of just tags.</p>
			<p>
				originally created by
				<a href={ templ.SafeURL(AuthorURL) } target="_blank" rel="noopener">{ AuthorName }</a>.
			</p>
			// Three links, not the two this comment used to argue for. That
			// count was about the original author's repository being a third
			// equal-weight destination competing with the two that concern
			// this site - it is still one click further in, on the About page
			// beside the credit that explains what it is. New is different: a
			// page of this site, not an outbound link, so it belongs beside
			// Search rather than behind it.
			// A plain navigation, not an htmx swap. Swapping /about into
			// #page-content left the visitor reading about-content under
			// whatever URL they were already on - refresh and share both
			// resurrected the wrong page. Search state survives the round
			// trip anyway: every applied filter lives in the query string.
			<nav class="masthead-links">
				<a href="/new">New</a>
				<a href="/about">About</a>
				<a href={ templ.SafeURL(SourceURL) } target="_blank" rel="noopener">Source</a>
			</nav>
		</div>
	</header>
}

// SearchBar keeps the applied filters as hidden fields, so submitting a new
// search narrows the results already on screen rather than silently discarding
// the tags the visitor picked. Sort is deliberately not carried: it is the one
// control whose sensible default changes with the query, from popularity to
// relevance.
templ SearchBar(f Filters) {
	<form
		class="searchbar"
		role="search"
		action="/"
		method="get"
		hx-get="/results"
		hx-target="#results-region"
		hx-swap="innerHTML"
	>
		<input
			id="query-input"
			type="text"
			name="q"
			value={ f.Query }
			placeholder="pixel art tileset, isometric, bones..."
			aria-label="Search assets"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
		/>
		for _, tag := range f.Tags {
			<input type="hidden" name="tags" value={ tag }/>
		}
		for _, tag := range f.NotTags {
			<input type="hidden" name="not" value={ tag }/>
		}
		if f.Author != "" {
			<input type="hidden" name="author" value={ f.Author }/>
		}
		if f.Price != "" {
			<input type="hidden" name="price" value={ f.Price }/>
		}
		if f.Currency != "" {
			<input type="hidden" name="cur" value={ f.Currency }/>
		}
		<button type="submit">Search</button>
		<div class="spinner" aria-hidden="true"></div>
	</form>
}

// Index renders the whole page, results included, so that any filtered URL is
// a shareable link that lands on populated results rather than on an empty box
// that then fetches them.
templ Index(f Filters, r Results, age Freshness, coverage Coverage) {
	@Masthead(age, coverage)
	<div id="page-content">
		@SearchBar(f)
		<div id="results-region" class="results-region">
			@ResultsRegion(f, r)
		</div>
	</div>
}
