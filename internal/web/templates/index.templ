package templates

import "fmt"
import "net/url"

// searchURL builds the URL for one page of results. Query escaping matters
// here: a search for "a&b" would otherwise truncate at the ampersand.
func searchURL(query string, page int64) string {
	return fmt.Sprintf("/search?q=%s&page=%d", url.QueryEscape(query), page)
}

templ Masthead() {
	<header class="masthead">
		<h1 class="wordmark-heading">
			<a class="wordmark" href="/" aria-label="itchgrep home">
				<span>ITCH</span><span class="mark-grep">GREP</span><span class="caret" aria-hidden="true"></span>
			</a>
		</h1>
		<div class="masthead-meta">
			<p>search itch.io/game-assets by text instead of just tags.</p>
			<p>
				created by
				<a href="https://github.com/wintermute-cell" target="_blank" rel="noopener">winterveil</a>.
			</p>
			<nav class="masthead-links">
				<a href="#" hx-get="/about" hx-swap="outerHTML" hx-target="#page-content">About</a>
				<a href="https://github.com/wintermute-cell/itchgrep" target="_blank" rel="noopener">GitHub</a>
				<a href="https://www.buymeacoffee.com/winterv" target="_blank" rel="noopener">Donate</a>
			</nav>
		</div>
	</header>
}

// Index renders the whole page. A non-empty query is rendered into the search
// box and loaded as results, so /?q=pixel+art is a shareable link rather than
// an empty page.
templ Index(query string) {
	@Masthead()
	<div id="page-content">
		<form
			class="searchbar"
			role="search"
			action="/"
			method="get"
			hx-get="/search"
			hx-target="#asset-list"
			hx-swap="innerHTML"
		>
			<input
				id="query-input"
				type="text"
				name="q"
				value={ query }
				placeholder="pixel art tileset, isometric, bones..."
				aria-label="Search assets"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
				required
			/>
			<button type="submit">Search</button>
			<div class="spinner" aria-hidden="true"></div>
		</form>
		<div id="asset-list">
			if query != "" {
				<div hx-get={ searchURL(query, 1) } hx-trigger="load" hx-swap="outerHTML" hx-target="this"></div>
			} else {
				<div hx-get="/assets/1" hx-trigger="load" hx-swap="outerHTML" hx-target="this"></div>
			}
		</div>
	</div>
}
