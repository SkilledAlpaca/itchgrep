package templates

// StatsPage is the public traffic page: aggregate counts only, nothing
// per-client. See internal/metrics for the counting rules and
// internal/web/templates/traffic.go for the view model this renders.
//
// Deliberately absent: 404s, scanner probes blocked, 429s, 5xx. Those are
// operator-side signals - a public probe counter is a feedback channel a
// scanner author could use to tune around the matcher, and the error counters
// tell an attacker how the origin is reacting. They stay in the log.
templ StatsPage(age Freshness, coverage Coverage, tr Traffic, history History) {
	@Masthead(age, coverage)
	<div id="page-content" class="prose stats-page">
		<h2>Traffic</h2>
		<p>Counted in the process, never read back out of a log - see the
		<a href="/about">About</a>
		page for how this site is built.</p>
		<dl class="stats-grid stats-headline">
			<div class="stats-cell">
				<dt>Total requests</dt>
				<dd>{ HumaneCount(tr.Total()) }</dd>
			</div>
			<div class="stats-cell">
				<dt>Searches served</dt>
				<dd>{ HumaneCount(tr.Searches()) }</dd>
			</div>
			<div class="stats-cell">
				<dt>Uptime</dt>
				<dd>{ tr.UptimeLabel() }</dd>
			</div>
			<div class="stats-cell">
				<dt>Counting since</dt>
				<dd>
					// js-local marks this for app.js to rewrite whole, not just
					// its title: unlike the relative "N days ago" labels
					// elsewhere on the page, this is already an absolute
					// timestamp, so the local rendering can replace it outright
					// rather than sit alongside it on hover.
					<time class="js-local" datetime={ tr.CountingSinceDateTime() }>{ tr.CountingSince() }</time>
				</dd>
			</div>
		</dl>
		<h2>By page</h2>
		<table class="stats-table">
			<tbody>
				<tr>
					<th scope="row">Home page</th>
					<td>{ HumaneCount(tr.Index()) }</td>
				</tr>
				<tr>
					<th scope="row">Results fragment</th>
					<td>{ HumaneCount(tr.Results()) }</td>
				</tr>
				<tr>
					<th scope="row">About page</th>
					<td>{ HumaneCount(tr.About()) }</td>
				</tr>
				<tr>
					<th scope="row">Static assets</th>
					<td>{ HumaneCount(tr.Static()) }</td>
				</tr>
				<tr>
					<th scope="row">New arrivals page</th>
					<td>{ HumaneCount(tr.New()) }</td>
				</tr>
				<tr>
					<th scope="row">Feed requests</th>
					<td>{ HumaneCount(tr.Feed()) }</td>
				</tr>
				<tr>
					<th scope="row">Tag pages</th>
					<td>{ HumaneCount(tr.Tag()) }</td>
				</tr>
				<tr>
					<th scope="row">Saved page</th>
					<td>{ HumaneCount(tr.Saved()) }</td>
				</tr>
				<tr>
					<th scope="row">Other</th>
					<td>{ HumaneCount(tr.Other()) }</td>
				</tr>
			</tbody>
		</table>
		<h2>Searches, last 24 hours</h2>
		<div class="stats-histogram">
			for i, bar := range tr.Bars() {
				<div class="stats-bar-col">
					<meter
						class="stats-bar"
						min="0"
						max={ tr.PeakAttr() }
						value={ bar.CountAttr() }
						title={ bar.Title() }
					></meter>
					// A label under every bar would crowd into illegibility at
					// 24 across; every third one keeps the axis readable while
					// still spanning the full day. app.js rewrites the label
					// into the viewer's own zone from data-epoch - the text
					// here is the UTC fallback for anyone without scripting.
					if i%3 == 0 {
						<span class="stats-bar-label" data-epoch={ bar.EpochAttr() }>{ bar.Label }</span>
					}
				</div>
			}
		</div>
		if !history.Empty() {
			<h2>Index history</h2>
			<div class="history-list">
				for _, row := range history.Rows() {
					<details class="history-row">
						<summary>{ row.Summary() }</summary>
						<dl>
							<div class="history-cell">
								<dt>Coverage</dt>
								<dd>{ row.CoverageLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Duration</dt>
								<dd>{ row.DurationLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>New assets</dt>
								<dd>{ row.NewAssetsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Removed assets</dt>
								<dd>{ row.RemovedAssetsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Free / paid</dt>
								<dd>{ row.FreePaidLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Pages fetched</dt>
								<dd>{ row.PagesLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Slices done/planned</dt>
								<dd>{ row.SlicesLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>429 refusals</dt>
								<dd>{ row.RefusalsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Tags planned against</dt>
								<dd>{ row.TagsLabel() }</dd>
							</div>
							if row.Resumed() {
								<div class="history-cell">
									<dt>Checkpoint</dt>
									<dd>resumed from checkpoint</dd>
								</div>
							}
						</dl>
					</details>
				}
			</div>
		}
		<hr/>
		<p><a href="/">← Back to search</a></p>
	</div>
}
