package templates

// StatsPage is the public traffic page: aggregate counts only, nothing
// per-client. See internal/metrics for the counting rules and
// internal/web/templates/traffic.go for the view model this renders.
//
// Deliberately absent: 404s, scanner probes blocked, 429s, 5xx. Those are
// operator-side signals - a public probe counter is a feedback channel a
// scanner author could use to tune around the matcher, and the error counters
// tell an attacker how the origin is reacting. They stay in the log.
templ StatsPage(tr Traffic, history History) {
	<div class="prose stats-page">
		<h2>Traffic</h2>
		<p>Counted in the process, never read back out of a log - see the
		<a href="/about">About</a>
		page for how this site is built.</p>
		<dl class="stats-grid stats-headline">
			<div class="stats-cell">
				<dt>Total requests</dt>
				<dd>{ humaniseCount(tr.Total()) }</dd>
			</div>
			<div class="stats-cell">
				<dt>Searches served</dt>
				<dd>{ humaniseCount(tr.Searches()) }</dd>
			</div>
			<div class="stats-cell">
				<dt>Uptime</dt>
				<dd>{ tr.UptimeLabel() }</dd>
			</div>
			<div class="stats-cell">
				<dt>Counting since</dt>
				<dd>
					// js-local marks this for app.js to rewrite whole, not just
					// its title: unlike the relative "N days ago" labels
					// elsewhere on the page, this is already an absolute
					// timestamp, so the local rendering can replace it outright
					// rather than sit alongside it on hover.
					<time class="js-local" datetime={ tr.CountingSinceDateTime() }>{ tr.CountingSince() }</time>
				</dd>
			</div>
		</dl>
		<h2>By page</h2>
		<table class="stats-table">
			<tbody>
				<tr>
					<th scope="row">Home page</th>
					<td>{ humaniseCount(tr.Index()) }</td>
				</tr>
				<tr>
					<th scope="row">Results fragment</th>
					<td>{ humaniseCount(tr.Results()) }</td>
				</tr>
				<tr>
					<th scope="row">About page</th>
					<td>{ humaniseCount(tr.About()) }</td>
				</tr>
				<tr>
					<th scope="row">Stats page</th>
					<td>{ humaniseCount(tr.Stats()) }</td>
				</tr>
				<tr>
					<th scope="row">Static assets</th>
					<td>{ humaniseCount(tr.Static()) }</td>
				</tr>
				<tr>
					<th scope="row">New arrivals page</th>
					<td>{ humaniseCount(tr.New()) }</td>
				</tr>
				<tr>
					<th scope="row">Feed requests</th>
					<td>{ humaniseCount(tr.Feed()) }</td>
				</tr>
				<tr>
					<th scope="row">Tag pages</th>
					<td>{ humaniseCount(tr.Tag()) }</td>
				</tr>
				<tr>
					<th scope="row">Saved page</th>
					<td>{ humaniseCount(tr.Saved()) }</td>
				</tr>
				<tr>
					<th scope="row">Other</th>
					<td>{ humaniseCount(tr.Other()) }</td>
				</tr>
			</tbody>
		</table>
		<h2>Searches, last 90 days</h2>
		{{ grid := tr.Grid() }}
		<p>{ grid.Summary() }</p>
		<p class="activity-note">Dates are UTC. Daily counts began when this view replaced the hourly chart, so earlier days read as empty.</p>
		// A real table, so screen readers get row and column navigation, with
		// the count for every day as hidden text: colour alone never carries
		// the figure. The wrapper scrolls sideways at narrow widths and is
		// focusable for exactly that reason; the cells themselves are not,
		// since 90 tab stops would bury the rest of the page.
		<div class="activity-scroll" role="region" aria-label="Search activity by day, scrolls sideways" tabindex="0">
			<table class="activity-grid">
				<caption class="visually-hidden">Searches, last 90 days (UTC)</caption>
				<thead>
					<tr>
						<td></td>
						for _, month := range grid.Months {
							<th scope="col">{ month }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range grid.Rows {
						<tr>
							<th scope="row">
								if row.ShowShort() {
									<span aria-hidden="true">{ row.Short }</span>
									<span class="visually-hidden">{ row.Name }</span>
								} else {
									<span class="visually-hidden">{ row.Name }</span>
								}
							</th>
							for _, cell := range row.Cells {
								if cell.InWindow {
									<td class={ cell.Class() } title={ cell.Label }>
										<span class="visually-hidden">{ cell.Label }</span>
									</td>
								} else {
									<td class={ cell.Class() } aria-hidden="true"></td>
								}
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="activity-legend" aria-hidden="true">
			<span>Less</span>
			<span class="activity-cell activity-l0"></span>
			<span class="activity-cell activity-l1"></span>
			<span class="activity-cell activity-l2"></span>
			<span class="activity-cell activity-l3"></span>
			<span class="activity-cell activity-l4"></span>
			<span>More</span>
		</div>
		// The shading differs by lightness alone, so the same figures are
		// listed as text (WCAG 1.4.1). Omitted when there are none: the
		// summary line above already says so.
		if days := grid.Days(); len(days) > 0 {
			<details class="activity-days">
				<summary>Daily counts</summary>
				<p>Days not listed had no searches.</p>
				<ul>
					for _, d := range days {
						<li>{ d.Label }</li>
					}
				</ul>
			</details>
		}
		if !history.Empty() {
			<h2>Index history</h2>
			<div class="history-list">
				for _, row := range history.Rows() {
					<details class="history-row">
						<summary>{ row.Summary() }</summary>
						<dl>
							<div class="history-cell">
								<dt>Coverage</dt>
								<dd>{ row.CoverageLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Duration</dt>
								<dd>{ row.DurationLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>New assets</dt>
								<dd>{ row.NewAssetsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Removed assets</dt>
								<dd>{ row.RemovedAssetsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Free / paid</dt>
								<dd>{ row.FreePaidLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Pages fetched</dt>
								<dd>{ row.PagesLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Slices done/planned</dt>
								<dd>{ row.SlicesLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>429 refusals</dt>
								<dd>{ row.RefusalsLabel() }</dd>
							</div>
							<div class="history-cell">
								<dt>Tags planned against</dt>
								<dd>{ row.TagsLabel() }</dd>
							</div>
							if row.Resumed() {
								<div class="history-cell">
									<dt>Checkpoint</dt>
									<dd>resumed from checkpoint</dd>
								</div>
							}
						</dl>
					</details>
				}
			</div>
		}
		<hr/>
		<p><a href="/">← Back to search</a></p>
	</div>
}
