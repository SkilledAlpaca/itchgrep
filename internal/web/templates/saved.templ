package templates

// SavedPage renders /saved. Every other page here is built from a server-side
// query; this one is not, because the list it shows was never sent to the
// server to begin with - see AssetCard's save button. The handler therefore
// has nothing to look up: the grid starts empty, and a <template> skeleton
// plus app.js are what turn it into cards, from localStorage, in the browser
// that saved them.
//
// This is the one page on the site that requires scripting. Every other page
// here works with it off by design; a saved list kept off the server has
// nowhere else to live, so the <noscript> notice says that plainly instead of
// leaving a visitor looking at an unexplained empty grid.
templ SavedPage(age Freshness, coverage Coverage) {
	@Masthead(age, coverage)
	<div id="page-content">
		<div class="prose">
			<h2>Saved</h2>
			<p>
				Saved items live only in this browser's local storage. A
				save is never sent to this server - not the list, not even a
				count of it - and it is never logged or synced anywhere
				else. Clearing this browser's site data clears the list too.
			</p>
		</div>
		<noscript>
			<div class="notice">
				<h2>This page needs JavaScript</h2>
				<p>
					Saving happens entirely in your browser, with nothing
					reaching the server - so there is no server-rendered list
					this page can fall back to. Every other page here works
					with scripting off; this is the one exception.
				</p>
			</div>
		</noscript>
		<div id="asset-list" data-saved-grid>
			<div id="saved-empty" class="notice" hidden>
				<h2>Nothing saved yet</h2>
				<p>Use the ☆ on any result to save it here.</p>
			</div>
		</div>
		<template id="saved-card-template">
			<article class="asset">
				<button
					type="button"
					class="asset-save"
					data-save-toggle
					aria-pressed="true"
				>★</button>
				<a class="asset-link" target="_blank" rel="noopener">
					<img data-role="thumb" loading="lazy" decoding="async" alt=""/>
					<div class="asset-body">
						<div class="asset-title" data-role="title"></div>
					</div>
				</a>
				<span class="asset-author" data-role="author"></span>
				<div class="asset-meta">
					<span class="asset-price" data-role="price"></span>
				</div>
			</article>
		</template>
	</div>
}
